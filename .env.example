# Court Document Management System - Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git!

# ==================== EMAIL CONFIGURATION ====================

# Gmail SMTP credentials
# Generate App Password at: https://myaccount.google.com/apppasswords
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password

# Default recipient for iPhone uploads
DEFAULT_EMAIL=recipient@example.com

# Server URL (used in email links)
SERVER_URL=http://192.168.1.218

# ==================== OCR CONFIGURATION ====================

# GPU selection mode: "auto" or "single"
OCR_GPU_SELECT=auto

# Device strategy: "single" or "auto"
OCR_DEVICE_STRATEGY=single

# GPU memory limit in GB
OCR_GPU_MEM_LIMIT_GB=22

# ==================== ORIENTATION DETECTION ====================

# Enable/disable ML orientation detection
ORIENTATION_DETECTION_ENABLED=true

# GPU memory threshold for orientation model (GB)
ORIENTATION_GPU_THRESHOLD_GB=8

# Inference timeout (seconds)
ORIENTATION_TIMEOUT_SEC=5

# Minimum confidence threshold
ORIENTATION_MIN_CONFIDENCE=0.7

# ==================== DATABASE ====================

# Database connection URL (default: sqlite)
# DB_URL=sqlite:///data.db
